root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{yml,yaml,json,js,ts,tsx,jsx,css,html}]
indent_style = space
indent_size = 2

[*.md]
# Markdown 里行尾两个空格是有意义的分行语法，不能自动裁掉。
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
